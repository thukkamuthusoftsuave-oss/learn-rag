# Copy to .env and fill in. Never commit the real .env.

# Required for real answers. Create a key at https://openrouter.ai/keys.
# Without it the assistant falls back to a mock LLM and says so in every response.
OPENROUTER_API_KEY=your_key_here

# --- Where the embeddings live ---
# "local" keeps them in RAG_CHROMA_DIR on this machine (default, no account).
# "cloud" stores them in a hosted Chroma Cloud database - create one at
# https://trychroma.com, then set all three values below and re-run `ingest`.
# The docstore in RAG_STORAGE_DIR stays local either way: auto-merging
# retrieval and BM25 both read from it.
# RAG_VECTOR_BACKEND=cloud
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# --- Optional overrides (defaults shown) ---
# RAG_DATA_DIR=data
# RAG_CHROMA_DIR=chroma_db
# RAG_STORAGE_DIR=storage
# RAG_TRACE_FILE=var/traces.jsonl
# RAG_REPORTS_DIR=reports

# RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# RAG_LLM_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# RAG_LLM_CONTEXT_WINDOW=32768
# RAG_LLM_MAX_TOKENS=512
# RAG_COLLECTION=hr_policies

# RAG_TOP_K=5
# RAG_HYBRID=true
# RAG_MAX_HISTORY_TURNS=6

# Seconds between questions in `eval quality`. Raise it if the selected model
# or account has a lower request-per-minute limit.
# RAG_EVAL_PAUSE_SECONDS=2
# RAG_EVAL_RETRIES=2

# Set to false to remove the admin console and its routes entirely.
# RAG_ADMIN_ENABLED=true

# RAG_HOST=0.0.0.0
# RAG_PORT=8000
